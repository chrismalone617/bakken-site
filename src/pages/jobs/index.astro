---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchIndeedJobs, INDEED_SEARCH_URL } from '../../lib/indeed-rss';

const jobs = await fetchIndeedJobs(50);
---

<BaseLayout title="Oil & Gas Jobs" description="Oil and gas jobs in the Williston Basin and Bakken Shale. Find drilling, production, and energy sector opportunities in North Dakota." canonicalPath="/jobs">
  <article class="min-h-screen">
    <header class="relative overflow-hidden bg-[var(--color-bakken-dark)] text-white">
      <div class="relative mx-auto max-w-4xl px-6 py-16 md:py-24">
        <nav class="mb-6 flex items-center gap-2 text-sm text-slate-400">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-slate-300">Jobs</span>
        </nav>
        <h1 class="font-serif text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
          Oil & Gas Jobs
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-slate-400">
          Career opportunities in the Williston Basin and Bakken Shale. Drilling, production, engineering, and energy sector positions.
        </p>
        <a
          href={INDEED_SEARCH_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-xl bg-[var(--color-bakken-accent)] px-6 py-3 font-bold text-[var(--color-bakken-dark)] transition-all hover:bg-emerald-400"
        >
          Search on Indeed
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-6 py-16">
      {jobs.length > 0 ? (
        <ul class="space-y-4">
          {jobs.map((job) => (
            <li>
              <a
                href={job.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col gap-3 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-all hover:border-[var(--color-bakken-accent)]/30 hover:shadow-lg hover:shadow-slate-200/50 sm:flex-row sm:items-center sm:justify-between"
              >
                <div class="flex min-w-0 flex-1 gap-4">
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-slate-50 group-hover:bg-[var(--color-bakken-accent)]/10 transition-colors">
                    <svg class="h-7 w-7 text-slate-400 group-hover:text-[var(--color-bakken-accent)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  </div>
                  <div class="min-w-0 flex-1">
                    <h2 class="font-bold text-slate-900 group-hover:text-[var(--color-bakken-dark)] transition-colors">
                      {job.title}
                    </h2>
                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500">
                      {job.company && <span>{job.company}</span>}
                      {job.company && job.location && <span class="text-slate-300">·</span>}
                      <span>{job.location ?? 'Williston Basin'}</span>
                    </div>
                    {job.description && (
                      <p class="mt-2 line-clamp-2 text-sm text-slate-600">
                        {job.description}
                      </p>
                    )}
                  </div>
                </div>
                <div class="flex shrink-0 items-center gap-3 sm:pl-4">
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-slate-400">
                    Indeed
                  </span>
                  <span class="rounded-full p-2 text-slate-400 transition-colors group-hover:bg-[var(--color-bakken-accent)]/10 group-hover:text-[var(--color-bakken-accent)]">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-12 text-center">
          <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-slate-100">
            <svg class="h-10 w-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="mb-2 text-xl font-bold text-slate-900">Oil & gas jobs in the Williston Basin</h2>
          <p class="mb-8 max-w-md mx-auto text-slate-600">
            Browse the latest openings on Indeed for drilling, production, engineering, and energy sector positions.
          </p>
          <a
            href={INDEED_SEARCH_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-bakken-accent)] px-8 py-4 font-bold text-[var(--color-bakken-dark)] transition-all hover:bg-emerald-400"
          >
            Search jobs on Indeed
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </article>
</BaseLayout>
