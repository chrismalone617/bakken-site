---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fetchIndeedJobs, INDEED_SEARCH_URL } from '../lib/indeed-rss';
import { getHomepageData, fetchJsonHttps } from '../lib/api-cache';
import { getFeaturedImage } from '../lib/featured-image';

const newsPages = await getCollection('pages', ({ id }) => id.startsWith('bsp-news/news/'));
newsPages.sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0));
const featuredNews = newsPages.slice(0, 3);

const eiaKey = import.meta.env.EIA_API_KEY ?? process.env.EIA_API_KEY;

async function fetchEiaData(): Promise<{
  wtiPrice: number | null;
  gasPrice: number | null;
  productionMbpd: number | null;
  rigCount: number | null;
  chartData: Array<{ name: string; value: number }>;
  productionYoY: number | null;
}> {
  const empty = {
    wtiPrice: null,
    gasPrice: null,
    productionMbpd: null,
    rigCount: null,
    chartData: [] as Array<{ name: string; value: number }>,
    productionYoY: null,
  };
  if (!eiaKey) return empty;

  const timeout = 25_000;
  interface EiaDataRow {
    period: string;
    value: string;
  }
  interface EiaResponse {
    response?: { data?: EiaDataRow[] };
  }

  async function fetchEiaJson(url: string): Promise<EiaResponse | null> {
    const json = await fetchJsonHttps(url, timeout);
    return (json ?? null) as EiaResponse | null;
  }

  try {
    const end = new Date().toISOString().slice(0, 7);
    const delay = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // Stagger requests to avoid EIA rate limiting (they throttle rapid parallel calls)
    const priceRes1 = await fetchEiaJson(`https://api.eia.gov/v2/petroleum/pri/spt/data/?api_key=${eiaKey}&data[0]=value&frequency=daily&facets[series][]=RWTC&sort[0][column]=period&sort[0][direction]=desc&length=1`);
    await delay(500);
    const priceRes2 = await fetchEiaJson(`https://api.eia.gov/v2/natural-gas/pri/fut/data/?api_key=${eiaKey}&data[0]=value&frequency=daily&facets[duoarea][]=RGC&sort[0][column]=period&sort[0][direction]=desc&length=1`);
    await delay(500);
    const [steoRes1, steoRes2, trendRes, yoyRes] = await Promise.all([
      fetchEiaJson(`https://api.eia.gov/v2/steo/data/?api_key=${eiaKey}&data[0]=value&frequency=monthly&facets[seriesId][]=COPRBK&sort[0][column]=period&sort[0][direction]=desc&length=1`),
      fetchEiaJson(`https://api.eia.gov/v2/steo/data/?api_key=${eiaKey}&data[0]=value&frequency=monthly&facets[seriesId][]=RIGSBK&sort[0][column]=period&sort[0][direction]=desc&length=1`),
      fetchEiaJson(`https://api.eia.gov/v2/steo/data/?api_key=${eiaKey}&data[0]=value&frequency=monthly&facets[seriesId][]=COPRBK&sort[0][column]=period&sort[0][direction]=desc&end=${end}&length=6`),
      fetchEiaJson(`https://api.eia.gov/v2/steo/data/?api_key=${eiaKey}&data[0]=value&frequency=monthly&facets[seriesId][]=COPRBK&sort[0][column]=period&sort[0][direction]=desc&end=${end}&length=13`),
    ]);

    let wtiPrice = priceRes1?.response?.data?.[0]?.value != null ? parseFloat(String(priceRes1.response.data[0].value)) : null;
    let gasPrice = priceRes2?.response?.data?.[0]?.value != null ? parseFloat(String(priceRes2.response.data[0].value)) : null;
    const productionMbpd = steoRes1?.response?.data?.[0]?.value != null ? parseFloat(String(steoRes1.response.data[0].value)) : null;
    const rigCount = steoRes2?.response?.data?.[0]?.value != null ? parseFloat(String(steoRes2.response.data[0].value)) : null;

    let chartData: Array<{ name: string; value: number }> = [];
    const trendData = trendRes?.response?.data;
    if (trendData?.length) {
      const rows = [...trendData].reverse();
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      chartData = rows.map((r: { period: string; value: string }) => {
        const [, m] = r.period.split('-').map(Number);
        return { name: months[m - 1], value: Math.round(parseFloat(r.value) * 1000) };
      });
    }

    let productionYoY: number | null = null;
    const yoyData = yoyRes?.response?.data;
    if (yoyData && yoyData.length >= 13) {
      const current = parseFloat(yoyData[0]?.value ?? 0);
      const lastYear = parseFloat(yoyData[12]?.value ?? 0);
      if (lastYear !== 0) productionYoY = ((current - lastYear) / lastYear) * 100;
    }

    return { wtiPrice, gasPrice, productionMbpd, rigCount, chartData, productionYoY };
  } catch {
    return empty;
  }
}

const homepageData = await getHomepageData(fetchEiaData, () => fetchIndeedJobs(8));
const { eia, indeedJobs } = homepageData;
const { wtiPrice, gasPrice, productionMbpd, rigCount, productionYoY } = eia;
const chartDataRaw = eia.chartData;

const leadingOperators = [
  { name: 'Continental Resources', url: 'https://www.contres.com', logo: '/images/companies/continental.png' },
  { name: 'Hess Corporation', url: 'https://www.hess.com', logo: '/images/companies/hess.png' },
  { name: 'EOG Resources', url: 'https://www.eogresources.com', logo: '/images/companies/eog.png' },
  { name: 'Marathon Oil', url: 'https://www.conocophillips.com', logo: '/images/companies/marathon.png' },
  { name: 'Chord Energy', url: 'https://www.chordenergy.com', logo: '/images/companies/chord.png' },
  { name: 'Chevron', url: 'https://www.chevron.com', logo: '/images/companies/chevron.png' },
];

const mapFeatures = [
  'Real-time Rig Tracking',
  'Pipeline & Midstream Infrastructure',
  'County-level Production Data',
  'Geological Formation Layers',
];

const formations = [
  { name: 'Upper Shale', desc: 'High organic content, primary source rock for the formation.' },
  { name: 'Middle Member', desc: 'Dolomitic siltstone and sandstone, the primary target for drilling.' },
  { name: 'Lower Shale', desc: 'Secondary source rock and critical seal for the Three Forks.' },
  { name: 'Three Forks', desc: 'The underlying formation offering additional multi-bench potential.', accent: true },
];

function slugToUrl(id: string) {
  return '/' + (id.startsWith('pages/') ? id.slice(6) : id);
}

const chartData = chartDataRaw.length > 0 ? chartDataRaw : [
  { name: '—', value: 0 },
];
const chartMax = Math.max(...chartData.map(d => d.value), 1);
---

<BaseLayout
  title="Bakken Shale Play"
  description="Comprehensive news, real-time data, and career opportunities in the Williston Basin. The leading source for Bakken Shale since 2009."
  transparentNav={true}
  canonicalPath="/"
>
  <!-- Hero Section -->
  <section class="overflow-visible px-6 pb-20 pt-32">
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-16 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-700">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span>
              {productionYoY != null
                ? productionYoY >= 0
                  ? `Bakken Production Up ${productionYoY.toFixed(1)}% YoY`
                  : `Bakken Production Down ${Math.abs(productionYoY).toFixed(1)}% YoY`
                : 'Bakken Production'}
            </span>
          </div>
          <h1 class="mb-8 font-serif text-5xl font-bold leading-[1.1] text-[var(--color-bakken-dark)] md:text-6xl lg:text-7xl">
            The Pulse of the <br />
            <span class="italic text-[var(--color-bakken-accent)]">Bakken Shale.</span>
          </h1>
          <p class="mb-10 max-w-xl text-xl leading-relaxed text-slate-500">
            Comprehensive news, real-time data, and career opportunities in the Williston Basin. Stay ahead of the curve in America's premier oil play.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/maps"
              class="inline-flex items-center gap-2 rounded-2xl bg-[var(--color-bakken-dark)] px-8 py-4 font-bold text-white transition-all hover:bg-slate-800"
            >
              Explore Maps
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </a>
            <a
              href="/jobs"
              class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-8 py-4 font-bold text-[var(--color-bakken-dark)] transition-all hover:bg-slate-50"
            >
              Latest Jobs
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Chart Card -->
        <div class="overflow-visible rounded-[2.5rem] border border-slate-100 bg-white p-8 shadow-2xl shadow-slate-200/50">
          <div class="mb-4">
            <h3 class="text-lg font-bold text-slate-900">Production Trend</h3>
            <p class="text-sm text-slate-400">Williston Basin (MBPD, monthly)</p>
          </div>
          <p class="mb-6 text-sm text-slate-500">
            Monthly average Bakken crude oil production (thousand barrels per day) for the last 6 months. Source: EIA Short Term Energy Outlook.
          </p>
          <div class="w-full overflow-visible">
            <div class="flex h-40 items-end gap-1 overflow-visible">
              {chartData.map((d) => (
                <div
                  class="flex-1 rounded-t transition-all hover:opacity-90"
                  style={`height: ${(d.value / chartMax) * 100}%; background: linear-gradient(180deg, var(--color-bakken-accent) 0%, color-mix(in srgb, var(--color-bakken-accent) 30%, transparent) 100%);`}
                  title={`${d.name}: ${d.value.toLocaleString()} MBPD`}
                />
              ))}
            </div>
            <div class="mt-3 flex min-h-[2.5rem] justify-between gap-1 pb-2 pt-1 text-xs text-slate-400">
              {chartData.map((d) => (
                <div class="flex min-w-0 flex-1 flex-col items-center justify-end gap-1 text-center">
                  <span class="font-medium text-slate-600">{d.value > 0 ? d.value.toLocaleString() : '—'}</span>
                  <span class="inline-block py-0.5">{d.name}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-2xl bg-slate-50 p-4">
              <p class="mb-1 text-[10px] font-bold uppercase tracking-widest text-slate-400">WTI Crude</p>
              <p class="text-xl font-bold text-slate-900">{wtiPrice != null ? `$${wtiPrice.toFixed(2)}` : '—'}</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
              <p class="mb-1 text-[10px] font-bold uppercase tracking-widest text-slate-400">Rig Count (ND)</p>
              <p class="text-xl font-bold text-slate-900">{rigCount != null ? Math.round(rigCount) : '—'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="px-6 pb-20">
    <div class="mx-auto max-w-7xl">
      <div class="mb-6 flex items-center justify-between">
        <h3 class="text-sm font-bold uppercase tracking-widest text-slate-400">Live Market Data</h3>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition-all hover:shadow-md">
          <div class="mb-2 flex items-start justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">WTI Crude</span>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-slate-900">{wtiPrice != null ? `$${wtiPrice.toFixed(2)}` : '—'}</span>
            <span class="text-xs font-medium text-slate-400">bbl</span>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition-all hover:shadow-md">
          <div class="mb-2 flex items-start justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Rig Count (ND)</span>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-slate-900">{rigCount != null ? Math.round(rigCount) : '—'}</span>
            <span class="text-xs font-medium text-slate-400">active (monthly)</span>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition-all hover:shadow-md">
          <div class="mb-2 flex items-start justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Bakken Production</span>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-slate-900">{productionMbpd != null ? productionMbpd.toFixed(2) : '—'}</span>
            <span class="text-xs font-medium text-slate-400">Mbbl/d (monthly)</span>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition-all hover:shadow-md">
          <div class="mb-2 flex items-start justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Gas Price</span>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-slate-900">{gasPrice != null ? `$${gasPrice.toFixed(2)}` : '—'}</span>
            <span class="text-xs font-medium text-slate-400">MMBtu</span>
          </div>
        </div>
      </div>
      {wtiPrice == null && gasPrice == null && productionMbpd == null && rigCount == null && (
        <p class="mt-4 text-center text-sm text-slate-500">Market data temporarily unavailable</p>
      )}
    </div>
  </section>

  <!-- News Section -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="mb-4 font-serif text-4xl font-bold text-[var(--color-bakken-dark)]">Latest Industry News</h2>
          <p class="max-w-lg text-slate-500">The most critical updates from across the Bakken Shale, curated by industry experts.</p>
        </div>
        <a href="/bsp-news" class="flex items-center gap-2 font-bold text-[var(--color-bakken-accent)] transition-all hover:gap-3">
          View All News
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {featuredNews.length > 0 ? (
          featuredNews.map((entry) => {
            const featuredImg = getFeaturedImage(entry);
            return (
            <a
              href={slugToUrl(entry.id)}
              class="group overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm transition-all hover:shadow-xl"
            >
              <div class="relative h-48 overflow-hidden bg-slate-200">
                {featuredImg && (
                  <img
                    src={featuredImg}
                    alt=""
                    class="h-full w-full object-cover transition-transform group-hover:scale-105"
                  />
                )}
                <div class="absolute left-4 top-4">
                  <span class="rounded-full bg-[var(--color-bakken-dark)]/80 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white backdrop-blur-md">
                    News
                  </span>
                </div>
              </div>
              <div class="p-6">
                <span class="mb-2 block text-xs font-medium text-slate-400">
                  {entry.data.pubDate ? new Date(entry.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'}
                </span>
                <h3 class="mb-3 text-xl font-bold leading-tight text-slate-900 transition-colors group-hover:text-[var(--color-bakken-accent)]">
                  {entry.data.title}
                </h3>
                <p class="mb-4 line-clamp-2 text-sm text-slate-500">
                  {entry.data.description?.slice(0, 120) || 'Read more...'}
                </p>
                <div class="flex items-center font-bold text-sm text-[var(--color-bakken-accent)]">
                  Read More
                  <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          );
          })
        ) : (
          [1, 2, 3].map((i) => (
            <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white p-6">
              <div class="h-48 rounded bg-slate-100" />
              <div class="mt-4 h-4 w-24 rounded bg-slate-100" />
              <div class="mt-2 h-5 w-3/4 rounded bg-slate-100" />
              <a href="/bsp-news" class="mt-3 inline-block text-sm font-bold text-[var(--color-bakken-accent)]">View All News →</a>
            </div>
          ))
        )}
      </div>
    </div>
  </section>

  <!-- Jobs Section -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="relative overflow-hidden rounded-[3rem] bg-[var(--color-bakken-dark)] p-8 text-white md:p-16">
        <div class="pointer-events-none absolute top-0 right-0 h-full w-1/2 bg-gradient-to-l from-[color-mix(in_srgb,var(--color-bakken-accent)_10%,transparent)] to-transparent" />
        <div class="relative z-10">
          <div class="mb-12 flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
            <div>
              <h2 class="mb-4 font-serif text-4xl font-bold">Career Opportunities</h2>
              <p class="max-w-md text-slate-400">Find your next role with the top operators and service companies in the basin.</p>
            </div>
            <a
              href="/advertising"
              class="rounded-2xl bg-[var(--color-bakken-accent)] px-8 py-4 font-bold text-[var(--color-bakken-dark)] transition-all hover:bg-emerald-400"
            >
              Post a Job Listing
            </a>
          </div>

          <div class="rounded-3xl bg-white p-4 text-slate-900 md:p-8">
            <div class="mb-8 flex items-center gap-4 border-b border-slate-100 pb-6">
              <div class="relative flex-1">
                <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input
                  type="text"
                  placeholder="Search jobs (e.g. Engineer, Williston)..."
                  class="w-full rounded-xl border-none bg-slate-50 py-3 pl-12 pr-4 outline-none focus:ring-2 focus:ring-[var(--color-bakken-accent)]"
                />
              </div>
              <a href="/jobs" class="hidden rounded-xl bg-slate-900 px-6 py-3 font-bold text-white sm:block">
                Filter
              </a>
            </div>
            <div class="space-y-2">
              {indeedJobs.length > 0 ? (
                indeedJobs.map((job) => (
                  <a
                    href={job.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="data-grid-line flex flex-col gap-4 px-2 sm:flex-row sm:items-center sm:justify-between transition-colors hover:bg-slate-50/50"
                  >
                    <div class="flex items-start gap-4">
                      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-50">
                        <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                      </div>
                      <div>
                        <h4 class="font-bold text-slate-900">{job.title}</h4>
                        <div class="flex items-center gap-2 text-sm text-slate-500">
                          {job.company && <span>{job.company}</span>}
                          {job.company && job.location && <span class="h-1 w-1 rounded-full bg-slate-300" />}
                          <span>{job.location ?? 'Bakken Region'}</span>
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center justify-between gap-6 sm:justify-end">
                      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-slate-400">
                        Indeed
                      </span>
                      <span class="rounded-full p-2 transition-colors hover:bg-[var(--color-bakken-accent)]/10 hover:text-[var(--color-bakken-accent)]">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </span>
                    </div>
                  </a>
                ))
              ) : (
                <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-8 text-center">
                  <p class="mb-4 text-slate-600">Oil & gas jobs in the Williston Basin</p>
                  <a
                    href={INDEED_SEARCH_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-bakken-accent)] px-6 py-3 font-bold text-[var(--color-bakken-dark)] transition-all hover:bg-emerald-400"
                  >
                    Search jobs on Indeed
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              )}
            </div>
            <a
              href="/jobs"
              class="mt-8 flex w-full items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 py-4 font-bold text-slate-400 transition-all hover:border-[var(--color-bakken-accent)] hover:text-[var(--color-bakken-accent)]"
            >
              View All Jobs
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Geology Section -->
  <section class="relative overflow-hidden bg-slate-900 px-6 py-24 text-white">
    <div class="pointer-events-none absolute top-0 left-0 h-full w-full opacity-10" style="background: radial-gradient(#10b981 1px, transparent 1px); background-size: 40px 40px;" />
    <div class="relative z-10 mx-auto max-w-7xl">
      <div class="grid items-center gap-20 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-4 py-2 text-sm font-bold text-emerald-400">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Geological Insights</span>
          </div>
          <h2 class="mb-8 font-serif text-5xl font-bold leading-tight">
            Unlocking the <br />
            <span class="italic text-[var(--color-bakken-accent)]">Williston Basin.</span>
          </h2>
          <div class="space-y-6 text-lg leading-relaxed text-slate-400">
            <p>
              The Bakken Shale is a complex rock formation deposited in the late Devonian age. Consisting of three distinct layers, it serves as both a source rock and a seal for the underlying Three Forks formation.
            </p>
            <p>
              Modern horizontal drilling and hydraulic fracturing have transformed this once-unreachable resource into one of the world's most productive oil plays.
            </p>
          </div>
          <div class="mt-12 grid grid-cols-2 gap-8">
            <div>
              <p class="mb-1 text-3xl font-bold text-white">400B+</p>
              <p class="text-sm font-bold uppercase tracking-widest text-slate-500">Barrels in Place</p>
            </div>
            <div>
              <p class="mb-1 text-3xl font-bold text-white">40B</p>
              <p class="text-sm font-bold uppercase tracking-widest text-slate-500">Recoverable Est.</p>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4 pt-12">
            <div class="rounded-[2rem] border border-slate-700 bg-slate-800 p-6">
              <h4 class="mb-2 font-bold text-[var(--color-bakken-accent)]">Upper Shale</h4>
              <p class="text-xs text-slate-400">{formations[0].desc}</p>
            </div>
            <div class="rounded-[2rem] border border-slate-700 bg-slate-800 p-6">
              <h4 class="mb-2 font-bold text-[var(--color-bakken-accent)]">Middle Member</h4>
              <p class="text-xs text-slate-400">{formations[1].desc}</p>
            </div>
          </div>
          <div class="space-y-4">
            <div class="rounded-[2rem] border border-slate-700 bg-slate-800 p-6">
              <h4 class="mb-2 font-bold text-[var(--color-bakken-accent)]">Lower Shale</h4>
              <p class="text-xs text-slate-400">{formations[2].desc}</p>
            </div>
            <div class="rounded-[2rem] bg-[var(--color-bakken-accent)] p-6 text-[var(--color-bakken-dark)]">
              <h4 class="mb-2 font-bold">Three Forks</h4>
              <p class="text-xs font-medium">{formations[3].desc}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Companies Section -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 text-center">
        <h2 class="mb-4 font-serif text-4xl font-bold text-[var(--color-bakken-dark)]">Leading Operators</h2>
        <p class="mx-auto max-w-2xl text-slate-500">The companies driving innovation and production across the Bakken Shale Play.</p>
      </div>
      <div class="grid grid-cols-2 gap-8 md:grid-cols-3 lg:grid-cols-6">
        {leadingOperators.map((company) => (
          <a
            href={company.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center text-center"
          >
            <div class="logo-cell relative mb-4 flex h-20 w-20 items-center justify-center overflow-hidden rounded-2xl bg-white p-3 shadow-sm ring-1 ring-slate-100 transition-all group-hover:ring-[var(--color-bakken-accent)]/30 group-hover:shadow-md">
              <img
                src={company.logo}
                alt={`${company.name} logo`}
                class="relative z-10 h-full w-full object-contain"
                loading="lazy"
                onerror="this.style.display='none';var s=this.nextElementSibling;if(s)s.classList.remove('hidden')"
              />
              <div class="fallback-icon absolute inset-0 hidden flex items-center justify-center">
                <svg class="h-10 w-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
            </div>
            <span class="text-sm font-bold text-slate-600 transition-colors group-hover:text-[var(--color-bakken-dark)]">{company.name}</span>
          </a>
        ))}
      </div>
      <div class="mt-16 flex flex-col items-center justify-between gap-8 rounded-[2.5rem] border border-slate-100 bg-slate-50 p-8 md:flex-row">
        <div class="flex items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm">
            <svg class="h-8 w-8 text-[var(--color-bakken-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0h.5a2.5 2.5 0 002.5-2.5V8m0 4.305V11a2 2 0 01-2 2h-1a2 2 0 01-2-2v-2.945M12 20.055V18a2.5 2.5 0 00-2.5-2.5h-.5a2 2 0 00-2 2v2.945M3.055 20V18a2.5 2.5 0 012.5-2.5h.5a2 2 0 012 2v2.945" />
            </svg>
          </div>
          <div>
            <h4 class="text-xl font-bold text-slate-900">Carbon Capture & Storage</h4>
            <p class="text-slate-500">Explore the future of sustainable energy in the basin.</p>
          </div>
        </div>
        <a
          href="https://ccus.com"
          target="_blank"
          rel="noopener"
          class="rounded-2xl bg-[var(--color-bakken-dark)] px-8 py-4 font-bold text-white transition-all hover:bg-slate-800"
        >
          Visit CCUS.com
        </a>
      </div>
    </div>
  </section>

  <!-- Map Teaser -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-16 lg:grid-cols-2">
        <div class="order-2 lg:order-1">
          <a href="/maps" class="group relative block overflow-hidden rounded-[2.5rem] border-8 border-white shadow-2xl transition-transform hover:scale-[1.02]">
            <div class="aspect-[3/2] w-full bg-gradient-to-br from-[var(--color-bakken-dark)] to-slate-800" />
            <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-[var(--color-bakken-dark)]/80 via-[var(--color-bakken-dark)]/30 to-transparent">
              <div class="rounded-3xl bg-white/95 p-6 text-center shadow-xl backdrop-blur-md transition-all group-hover:bg-white group-hover:shadow-2xl">
                <svg class="mx-auto mb-4 h-12 w-12 text-[var(--color-bakken-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                <h4 class="mb-2 text-xl font-bold text-[var(--color-bakken-dark)]">Interactive Basin Map</h4>
                <p class="mb-4 text-sm text-slate-500">Formation extent, production heat, key cities.</p>
                <span class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-bakken-dark)] px-6 py-2 text-sm font-bold text-white group-hover:bg-slate-800">
                  Launch Map
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="mb-6 font-serif text-4xl font-bold leading-tight text-[var(--color-bakken-dark)]">
            Precision Data for <br />
            <span class="italic text-[var(--color-bakken-accent)]">Strategic Decisions.</span>
          </h2>
          <p class="mb-10 text-lg leading-relaxed text-slate-500">
            Our proprietary mapping engine combines geological data with real-time operational insights. Track the evolution of the play from discovery to maturity.
          </p>
          <ul class="mb-10 space-y-4">
            {mapFeatures.map((item) => (
              <li class="flex items-center gap-3 font-medium text-slate-700">
                <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100">
                  <div class="h-2 w-2 rounded-full bg-[var(--color-bakken-accent)]" />
                </div>
                {item}
              </li>
            ))}
          </ul>
          <a href="/bakken-shale-oil-formation" class="group inline-flex items-center gap-2 font-bold text-[var(--color-bakken-dark)]">
            Learn about Bakken Geology
            <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
