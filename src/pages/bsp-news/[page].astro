---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BspNewsGrid from '../../components/BspNewsGrid.astro';

export async function getStaticPaths() {
  const perPage = 20;
  const newsPages = await getCollection('pages', ({ id }) => id.startsWith('bsp-news/news/'));
  const sortedNews = newsPages.sort((a, b) => {
    const aDate = a.data.pubDate?.getTime() ?? 0;
    const bDate = b.data.pubDate?.getTime() ?? 0;
    return bDate - aDate;
  });
  const totalPages = Math.ceil(sortedNews.length / perPage);
  if (totalPages <= 1) return [];
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const p = i + 2;
    const start = (p - 1) * perPage;
    const pageNews = sortedNews.slice(start, start + perPage);
    return {
      params: { page: String(p) },
      props: { currentPage: p, totalPages, pageNews, totalCount: sortedNews.length },
    };
  });
}

const { currentPage, totalPages, pageNews, totalCount } = Astro.props;
---

<BaseLayout title="Bakken Shale News" description="The latest news, analysis, and updates from the Bakken Shale and Williston Basin. Industry coverage since 2009." canonicalPath={`/bsp-news/${currentPage}`}>
  <article class="min-h-screen">
    <header class="relative overflow-hidden bg-[var(--color-bakken-dark)] text-white">
      <div class="relative mx-auto max-w-4xl px-6 py-16 md:py-24">
        <nav class="mb-6 flex items-center gap-2 text-sm text-slate-400">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/bsp-news" class="hover:text-white transition-colors">News</a>
          <span>/</span>
          <span class="text-slate-300">Page {currentPage}</span>
        </nav>
        <h1 class="font-serif text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
          Bakken Shale News
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-slate-400">
          The latest news, analysis, and updates from the Bakken Shale and Williston Basin. Industry coverage since 2009.
        </p>
        <a
          href="/bsp-news/category/News"
          class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-bakken-accent)] hover:underline"
        >
          Browse by category
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-6 py-16">
      <BspNewsGrid
        pageNews={pageNews}
        currentPage={currentPage}
        totalPages={totalPages}
        totalCount={totalCount}
        perPage={20}
      />
    </div>
  </article>
</BaseLayout>
