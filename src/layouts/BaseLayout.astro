---
import '../styles/global.css';

const SITE = Astro.site?.toString() ?? 'https://bakkenshale.com';

interface Props {
  title: string;
  description?: string;
  transparentNav?: boolean;
  /** Canonical path (e.g. /about-bakkenshale-com). If omitted, uses current URL path. */
  canonicalPath?: string;
  /** OG/Twitter image URL (absolute). Falls back to default if not set. */
  ogImage?: string;
  /** og:type - 'website' or 'article' */
  ogType?: 'website' | 'article';
  /** JSON-LD Article schema for news posts. When set, renders Article schema. */
  articleSchema?: {
    headline: string;
    datePublished: string;
    dateModified?: string;
    author?: string;
    image?: string;
  };
}

const { title, description = '', transparentNav = false, canonicalPath, ogImage, ogType = 'website', articleSchema } = Astro.props;

const fullTitle = title.includes('—') ? title : `${title} — Bakken Shale Play`;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, SITE).toString() : Astro.url.toString();
const imageUrl = ogImage ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE).toString()) : new URL('/images/og-default.png', SITE).toString();

const newsSubmenu = [
  { name: 'Bakken News', href: '/bsp-news' },
  { name: 'Press Releases', href: '/press' },
  { name: 'Pipeline & Midstream News', href: '/pmn' },
  { name: 'Drilling Rig Count', href: '/drilling' },
  { name: 'Jobs News', href: '/bsp-jobs' },
  { name: 'Events', href: '/events' },
];

const jobsSubmenu = [
  { name: 'Operator Jobs', href: '/oil-gas-jobs' },
  { name: 'Oilfield Services Jobs', href: '/oilfield-services-jobs' },
  { name: 'Pipeline & Midstream Jobs', href: '/midstream-jobs' },
];

const mapsSubmenu = [
  { name: 'Bakken Maps', href: '/maps' },
  { name: 'Geology', href: '/geology' },
];

const companiesSubmenu = [
  { name: 'Bakken Companies', href: '/companies' },
  { name: 'Oilfield Services', href: '/oilfield-service-companies' },
  { name: 'Pipeline & Midstream', href: '/pipeline-midstream-companies' },
];

const countiesSubmenu = [
  { name: 'Bakken Counties', href: '/counties' },
  { name: 'Courthouse Directory', href: '/courthouse-directory' },
  { name: 'Chambers of Commerce', href: '/chamber-of-commerce-directory' },
  { name: 'Tax Office Directory', href: '/bakken-mineral-tax-appraisal-offices' },
];

const aboutSubmenu = [
  { name: 'About Us', href: '/about-bakkenshale-com' },
  { name: 'Contact', href: '/contact-us' },
  { name: 'Advertise', href: '/advertising' },
  { name: 'Safety Resources', href: '/healthcare' },
  { name: 'Archive', href: '/archive' },
  { name: 'Search', href: '/search-1' },
];

const navLinks = [
  { name: 'News', href: '/bsp-news', submenu: newsSubmenu },
  { name: 'Jobs', href: '/oil-gas-jobs', submenu: jobsSubmenu },
  { name: 'Maps', href: '/maps', submenu: mapsSubmenu },
  { name: 'Companies', href: '/companies', submenu: companiesSubmenu },
  { name: 'Counties', href: '/counties', submenu: countiesSubmenu },
  { name: 'About', href: '/about-bakkenshale-com', submenu: aboutSubmenu },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Bakken Shale Play" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- JSON-LD: WebSite (global) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      url: SITE,
      name: 'Bakken Shale Play',
      description: 'Bakken Shale news updates delivered from the North Dakota area oilfield. Information for the oil & gas industry, royalty owners, and business owners.',
      publisher: {
        '@type': 'Organization',
        name: 'KED Interests, LLC',
      },
    })} />

    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: articleSchema.headline,
        datePublished: articleSchema.datePublished,
        dateModified: articleSchema.dateModified ?? articleSchema.datePublished,
        author: articleSchema.author ? { '@type': 'Person', name: articleSchema.author } : { '@type': 'Organization', name: 'Bakken Shale Play' },
        publisher: { '@type': 'Organization', name: 'Bakken Shale Play', logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', SITE).toString() } },
        image: articleSchema.image ?? imageUrl,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      })} />
    )}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900" data-transparent-nav={transparentNav}>
    <header
      id="navbar"
      class={`fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300 ${transparentNav ? 'bg-transparent py-6' : 'bg-white/90 backdrop-blur-md shadow-sm py-3'}`}
    >
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6">
        <a href="/" class="flex items-center gap-2">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-bakken-dark)]">
            <svg class="h-6 w-6 text-[var(--color-bakken-accent)]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 21q-.425 0-.713-.288T3 20q0-.425.288-.713T4 19h1v-6H4q-.425 0-.713-.288T3 12q0-.425.288-.713T4 11h1V5H4q-.425 0-.713-.288T3 4q0-.425.288-.713T4 3h16q.425 0 .713.288T21 4q0 .425-.288.713T20 5h-1v6h1q.425 0 .713.288T21 12q0 .425-.288.713T20 13h-1v6h1q.425 0 .713.288T21 20q0 .425-.288.713T20 21H4Zm8-5q1.25 0 2.125-.863T15 13.05q0-.975-.563-1.675T12 8.5q-1.875 2.15-2.438 2.863T9 13.05q0 1.225.875 2.087T12 16Z"/>
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-[var(--color-bakken-dark)]">
            BAKKEN<span class="text-[var(--color-bakken-accent)]">SHALE</span>
          </span>
        </a>
        <div class="hidden items-center gap-8 md:flex">
          {navLinks.map((link) => (
            link.submenu ? (
              <div class="group relative">
                <a
                  href={link.href}
                  class="text-sm font-medium text-slate-600 transition-colors hover:text-[var(--color-bakken-accent)]"
                >
                  {link.name}
                  <svg class="ml-0.5 inline h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all group-hover:visible group-hover:opacity-100">
                  <div class="min-w-[220px] rounded-xl border border-slate-100 bg-white py-2 shadow-xl">
                    {link.submenu.map((item) => (
                      <a
                        href={item.href}
                        class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-[var(--color-bakken-accent)]"
                      >
                        {item.name}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                class="text-sm font-medium text-slate-600 transition-colors hover:text-[var(--color-bakken-accent)]"
              >
                {link.name}
              </a>
            )
          ))}
          <a
            href="/subscribe"
            class="rounded-full bg-[var(--color-bakken-dark)] px-5 py-2 text-sm font-medium text-white transition-all hover:bg-slate-800"
          >
            Subscribe
          </a>
        </div>
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>
      <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white p-6 shadow-xl md:hidden">
        <div class="flex flex-col gap-4">
          {navLinks.map((link) => (
            link.submenu ? (
              <div class="flex flex-col gap-2">
                <span class="text-sm font-bold uppercase tracking-wider text-slate-400">{link.name}</span>
                {link.submenu.map((item) => (
                  <a href={item.href} class="pl-4 text-lg font-medium text-slate-900">
                    {item.name}
                  </a>
                ))}
              </div>
            ) : (
              <a href={link.href} class="text-lg font-medium text-slate-900">
                {link.name}
              </a>
            )
          ))}
          <a href="/subscribe" class="mt-4 w-full rounded-xl bg-[var(--color-bakken-dark)] py-3 text-center font-medium text-white">
            Subscribe
          </a>
        </div>
      </div>
    </header>
    <main class="pt-16">
      <slot />
    </main>
    <footer class="bg-[var(--color-bakken-dark)] pt-24 pb-12 text-white">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mb-20 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="mb-8 flex items-center gap-2">
              <div class="flex h-8 w-8 items-center justify-center rounded bg-[var(--color-bakken-accent)]">
                <svg class="h-5 w-5 text-[var(--color-bakken-dark)]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 21q-.425 0-.713-.288T3 20q0-.425.288-.713T4 19h1v-6H4q-.425 0-.713-.288T3 12q0-.425.288-.713T4 11h1V5H4q-.425 0-.713-.288T3 4q0-.425.288-.713T4 3h16q.425 0 .713.288T21 4q0 .425-.288.713T20 5h-1v6h1q.425 0 .713.288T21 12q0 .425-.288.713T20 13h-1v6h1q.425 0 .713.288T21 20q0 .425-.288.713T20 21H4Zm8-5q1.25 0 2.125-.863T15 13.05q0-.975-.563-1.675T12 8.5q-1.875 2.15-2.438 2.863T9 13.05q0 1.225.875 2.087T12 16Z"/>
                </svg>
              </div>
              <span class="text-xl font-bold tracking-tight">
                BAKKEN<span class="text-[var(--color-bakken-accent)]">SHALE</span>
              </span>
            </div>
            <p class="mb-8 text-sm leading-relaxed text-slate-400">
              The leading source for news, data, and jobs in the Bakken Shale since 2009. Part of the KED Interests network.
            </p>
            <div class="flex gap-4">
              <a href="#" class="rounded-lg bg-slate-800 p-2 transition-all hover:bg-[var(--color-bakken-accent)] hover:text-[var(--color-bakken-dark)]">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="#" class="rounded-lg bg-slate-800 p-2 transition-all hover:bg-[var(--color-bakken-accent)] hover:text-[var(--color-bakken-dark)]">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="#" class="rounded-lg bg-slate-800 p-2 transition-all hover:bg-[var(--color-bakken-accent)] hover:text-[var(--color-bakken-dark)]">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>
          <div>
            <h4 class="mb-8 text-lg font-bold">Resources</h4>
            <ul class="space-y-4 text-sm text-slate-400">
              <li><a href="/bsp-news" class="transition-colors hover:text-white">Bakken News</a></li>
              <li><a href="/drilling" class="transition-colors hover:text-white">Drilling Reports</a></li>
              <li><a href="/bakken-shale-oil-formation" class="transition-colors hover:text-white">Geology Guide</a></li>
              <li><a href="/companies" class="transition-colors hover:text-white">Company Directory</a></li>
              <li><a href="/counties" class="transition-colors hover:text-white">County Courthouses</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-8 text-lg font-bold">Company</h4>
            <ul class="space-y-4 text-sm text-slate-400">
              <li><a href="/about-bakkenshale-com" class="transition-colors hover:text-white">About Us</a></li>
              <li><a href="/advertising" class="transition-colors hover:text-white">Advertising</a></li>
              <li><a href="/contact-us" class="transition-colors hover:text-white">Contact Us</a></li>
              <li><a href="/privacy-policy" class="transition-colors hover:text-white">Privacy Policy</a></li>
              <li><a href="/healthcare" class="transition-colors hover:text-white">Safety Resources</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-8 text-lg font-bold">Newsletter</h4>
            <p class="mb-6 text-sm text-slate-400">Get the weekly Bakken Briefing delivered to your inbox.</p>
            <form class="flex gap-2" action="/subscribe" method="get">
              <input
                type="email"
                name="email"
                placeholder="Email address"
                class="flex-1 rounded-xl border-none bg-slate-800 px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-bakken-accent)]"
              />
              <button type="submit" class="rounded-xl bg-[var(--color-bakken-accent)] p-3 font-bold text-[var(--color-bakken-dark)]">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </button>
            </form>
          </div>
        </div>
        <div class="flex flex-col items-center justify-between gap-6 border-t border-slate-800 pt-12 text-xs text-slate-500 md:flex-row">
          <p>© 2026 KED INTERESTS, LLC. ALL RIGHTS RESERVED.</p>
          <div class="flex gap-8">
            <a href="/terms-and-conditions-of-usage" class="hover:text-white">Terms of Service</a>
            <a href="/privacy-policy" class="hover:text-white">Cookie Policy</a>
            <a href="#" class="hover:text-white">Accessibility</a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      document.getElementById('mobile-menu-toggle')?.addEventListener('click', () => {
        const menu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        menu?.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
      });
      const body = document.body;
      if (body?.dataset.transparentNav === 'true') {
        const nav = document.getElementById('navbar');
        const update = () => {
          if (!nav) return;
          if (window.scrollY > 20) {
            nav.classList.add('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'py-3');
            nav.classList.remove('bg-transparent', 'py-6');
          } else {
            nav.classList.remove('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'py-3');
            nav.classList.add('bg-transparent', 'py-6');
          }
        };
        window.addEventListener('scroll', update);
      }
    </script>
  </body>
</html>
